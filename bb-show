#!/bin/bash
# bb-show — put a page in front of the human, taking turns with the other agents.
#
# Use this instead of:  open -a "Brave Browser" <url>
# That command goes straight to macOS, around the proxy, so the proxy cannot
# queue it. Two sessions doing it minutes apart is what throws the window back
# and forth. This one queues, and it closes the stale copy of the page first.
#
#   bb-show <url> [owner] [purpose]
#
# When the task is done, close what you showed: bb-close <owner|url-substring>.
# Rule: close every tab you opened the moment its task is done.
#
# Exit 0 shown · 2 screen busy (say so and move on, do NOT force it) · 1 error.
set -u
API="${BROKER_URL:-http://127.0.0.1:9223}"
URL="${1:-}"; OWNER="${2:-${BROKER_OWNER:-$(basename "${CLAUDE_SESSION_ID:-agent}")}}"; WHY="${3:-}"
[ -z "$URL" ] && { echo "usage: bb-show <url> [owner] [purpose]" >&2; exit 1; }

BODY=$(URL="$URL" OWNER="$OWNER" WHY="$WHY" python3 -c '
import json,os
print(json.dumps({"url":os.environ["URL"],"owner":os.environ["OWNER"],"purpose":os.environ["WHY"] or None}))')

OUT=$(curl -sS -m 60 -w $'\n%{http_code}' -X POST "$API/show" \
        -H "Content-Type: application/json" -d "$BODY" 2>/dev/null)
CODE=$(printf '%s' "$OUT" | tail -1)
JSON=$(printf '%s' "$OUT" | sed '$d')

case "$CODE" in
  200) echo "shown: $URL"
       echo "when the task is done, close it: bb-close $OWNER   (rule: close every tab you opened)"
       exit 0 ;;
  409) echo "screen busy — $JSON" >&2
       echo "not forcing it. tell the human the link instead: $URL" >&2; exit 2 ;;
  *)   # Broker down. Nothing should break just because the polite path is gone.
       echo "broker not answering (code=${CODE:-none}) — falling back to a raw open" >&2
       open -a "${BROWSER_APP:-Brave Browser}" "$URL" && exit 0 || exit 1 ;;
esac
