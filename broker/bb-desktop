#!/usr/bin/env python3
"""bb-desktop: borrow the virtual Mac instead of the human's real screen.

Matt (2026-11-04, 9:45 PM): "You take it, then build." Some jobs cannot be done
in a hidden tab (sites that refuse a background tab, native Mac apps, testing an
app on a clean machine, tools we do not trust). Until now the only place left was
his own screen. The mini runs a separate macOS guest under terminal-mac; this
gives agents an exclusive, logged lease on it, with the same rules as the browser
broker: one job at a time, look before every step, stuck means ask, give it back.
The guest has none of Matt's logins.

    bb-desktop lease   <owner> [--vm default] [--purpose "..."] [--ttl 1800]
    bb-desktop act     <owner> [--vm default] click X Y [--double] [--button right]
    bb-desktop act     <owner> key cmd+space
    bb-desktop act     <owner> type "text"          (per-key presses; --native for terminal-mac's own type)
    bb-desktop act     <owner> scroll --dy -300 [--dx N] [--x X --y Y]
    bb-desktop act     <owner> drag X Y X2 Y2
    bb-desktop act     <owner> screenshot [PATH]
    bb-desktop renew   <owner> [--vm default]
    bb-desktop peek    [--vm default]               read only: holder, purpose, expiry, VM state, fresh screenshot
    bb-desktop release <owner> [--vm default]        ends the lease and pauses the VM
    bb-desktop reap                                  pause every VM with no lease, idle 10+ min (launchd, 5 min)
    bb-desktop mcp     [--vm default]               terminal-mac's MCP tools (same names), behind a lease

Matt (2026-11-04, 10:20 PM): every model and job that is done frees its memory. So
release (and an expired lease) suspends the VM to disk (or pauses it, on a terminal-mac
without `suspend`; a pause stops the CPU but keeps the RAM), lease wakes it, and `reap` (plain code,
no model) pauses any running VM that has no lease and has sat idle 10+ minutes. A VM is
never paused while a lease is live, while a `terminal-mac view` viewer is attached, or by
reap while its CPU is busy (someone is working in it). A VM the broker did not wake gets
its 10 minutes counted from the first time reap sees it running.

Lease also takes a cleanly stopped VM: it starts it, and the guest logs in by itself and
opens its helper (allow up to ~3 minutes). A VM in any other state (error, starting,
stopping) or a saved state terminal-mac refuses to restore exits 2: ask the human.
BB_DESKTOP_SUSPEND=0 (or 1) overrides the suspend capability read from terminal-mac --help.

Every command prints one JSON line on stdout. A lease expires TTL seconds after
the last act/renew and is then free to take. The lease state lives on the machine
that owns the VM: on a machine without terminal-mac (the M5, the PC) the same
command runs on the VM host, LAN ssh first, then a relay. Each remote request carries
an id and the host remembers finished ones, so a repeat returns the first result
instead of typing or clicking twice. Once the LAN run has started it is never re-sent
over the relay. Where the host lives is not in this repo: set it in
~/.config/browser-agent/desktop.env (chmod 600) or the environment:

    BB_DESKTOP_MINI=user@vm-host.lan                  LAN ssh target of the VM host
    BB_DESKTOP_RELAY=user@relay.example.com           ssh target that can reach it from anywhere
    BB_DESKTOP_RELAY_RUN="/path/run-on.sh vm-host"    command there: <RELAY_RUN> '<shell cmd>' <timeout>

Exit 0 ok · 1 error (terminal-mac failed, mini unreachable, bad usage) · 2 the VM or
its guest helper is not ready · 3 you do not hold the lease · 4 another owner holds
it (the reply says who and why) · 5 stuck: this owner leased and released it twice
in the last 10 minutes; stop and ask the human in one line.
"""
import base64, json, os, re, shlex, shutil, subprocess, sys, time, uuid

HERE = os.path.dirname(os.path.realpath(__file__))
CONFIG = os.environ.get("BB_DESKTOP_CONFIG", os.path.expanduser("~/.config/browser-agent/desktop.env"))


def _load_config(path):
    """KEY=VALUE lines from the untracked config; the environment wins over the file."""
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                os.environ.setdefault(k, v)
    except OSError:
        pass


_load_config(CONFIG)
STATE = os.environ.get("BB_DESKTOP_STATE", os.path.join(HERE, "desktop-lease.json"))
LOG = os.environ.get("BB_DESKTOP_LOG", os.path.join(HERE, "desktop.log"))
SHOTS = os.environ.get("BB_DESKTOP_SHOTS", "/tmp/bb-desktop")
MINI = os.environ.get("BB_DESKTOP_MINI", "")
RELAY = os.environ.get("BB_DESKTOP_RELAY", "")
RELAY_RUN = os.environ.get("BB_DESKTOP_RELAY_RUN", "")
REMOTE_BIN = os.environ.get("BB_DESKTOP_REMOTE_BIN", "$HOME/Scripts/browser-agent/broker/bb-desktop")
# terminal-mac 0.2.0 build 6: `action type` returns {} and types nothing in a macOS 27
# guest, while `key <char>` works. Set BB_DESKTOP_NATIVE_TYPE=1 once upstream fixes it.
NATIVE_TYPE = os.environ.get("BB_DESKTOP_NATIVE_TYPE") == "1"
TTL = 1800
STUCK_WINDOW, STUCK_AFTER = 600, 2
IDLE_PAUSE = int(os.environ.get("BB_DESKTOP_IDLE", "600"))
CPU_BUSY = float(os.environ.get("BB_DESKTOP_CPU_BUSY", "10"))   # % across two samples
LOCK_WAIT = float(os.environ.get("BB_DESKTOP_LOCK_WAIT", "20"))
SUSPENDING_STALE = 600     # a "suspending" mark older than this is from a killed run
REQUEST_KEEP = 3600        # how long the host remembers a finished remote request
LEASE_BUDGET = 900         # suspend wait 300 + restore/start 180 + boot 120 + helper 180 (cold) + status calls
MCP_IDLE = float(os.environ.get("BB_DESKTOP_MCP_IDLE", "600"))


class Exit(Exception):
    def __init__(self, code, msg, **extra):
        super().__init__(msg)
        self.code, self.msg, self.extra = code, msg, extra


def budget(argv):
    """Seconds a command may take on the VM host. Callers (remote(), broker_client) add
    their own transport slack on top."""
    cmd = argv[0] if argv else ""
    if cmd == "lease":
        return LEASE_BUDGET
    if cmd == "release":
        return 240          # status 30 + suspend 180 + slack
    if cmd == "reap":
        return 600
    if cmd == "act" and "type" in argv:
        return 60 + 2 * len(" ".join(argv[argv.index("type") + 1:]))
    return 120


# ---- the per-key typing path ------------------------------------------------
# Key names terminal-mac accepts (Guest.swift `keys`, US layout). Shifted characters
# are shift+<base key>. There is no key for ` and ~ in 0.2.0, so those are refused.
_BASE = set("abcdefghijklmnopqrstuvwxyz0123456789=-][';\\,/.")
_SHIFTED = {"!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7", "*": "8",
            "(": "9", ")": "0", "_": "-", "+": "=", "{": "[", "}": "]", "|": "\\", ":": ";",
            '"': "'", "<": ",", ">": ".", "?": "/"}
_NAMED = {" ": "space", "\n": "return", "\t": "tab"}


def keys_for(text):
    """The terminal-mac key chords that type `text`, one per character. Raises Exit(1)
    naming every character that has no key, before anything is sent."""
    out, bad = [], []
    for ch in text:
        if ch in _NAMED:
            out.append(_NAMED[ch])
        elif ch in _BASE:
            out.append(ch)
        elif ch.isascii() and ch.isalpha() and ch.isupper():
            out.append("shift+" + ch.lower())
        elif ch in _SHIFTED:
            out.append("shift+" + _SHIFTED[ch])
        else:
            bad.append(ch)
    if bad:
        raise Exit(1, "no key for %s; nothing was typed (use --native to try terminal-mac's own type)"
                   % ", ".join(repr(c) for c in sorted(set(bad))))
    return out


# ---- where terminal-mac lives -------------------------------------------------
def local_tmac():
    """Path to terminal-mac on this machine, or None (then the VM host runs the command)."""
    forced = os.environ.get("BB_DESKTOP_TMAC")
    if forced is not None:
        return forced or None
    return shutil.which("terminal-mac") or next(
        (p for p in [os.path.expanduser("~/.local/bin/terminal-mac")] if os.access(p, os.X_OK)), None)


def tmac(*args, timeout=60):
    """Run terminal-mac; returns its JSON reply. Raises Exit(1) on failure."""
    try:
        p = subprocess.run([TMAC, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Exit(1, "terminal-mac %s timed out after %ss" % (" ".join(args[:3]), timeout))
    try:
        reply = json.loads(p.stdout) if p.stdout.strip() else {}
    except ValueError:
        reply = {"output": p.stdout.strip()}
    if p.returncode != 0:
        raise Exit(1, "terminal-mac %s failed: %s" % (" ".join(args[:3]), (p.stderr or p.stdout).strip()[:300]))
    return reply


def vm_status(vm):
    """(state, pid) from terminal-mac status."""
    r = tmac("status", vm, timeout=30)
    return r.get("state"), r.get("pid")


# ---- lease state (one JSON file, flock'd, never held across a slow call) -------
class State:
    def __enter__(self):
        import fcntl    # here, not at the top: Windows has no fcntl and only ever runs the remote path
        self.fcntl = fcntl
        os.makedirs(os.path.dirname(STATE) or ".", exist_ok=True)
        self.lock = open(STATE + ".lock", "a")
        deadline = time.time() + LOCK_WAIT
        while True:
            try:
                fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() > deadline:
                    self.lock.close()
                    raise Exit(1, "the desktop lease state stayed locked for %ds (another bb-desktop is"
                               " stuck holding it); try again" % LOCK_WAIT)
                time.sleep(0.1)
        try:
            with open(STATE) as f:
                self.data = json.load(f)
        except (OSError, ValueError):
            self.data = {}
        return self

    def vm(self, name):
        return self.data.setdefault(name, {"lease": None, "history": []})

    def save(self):
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.data, f, indent=1)
        os.replace(tmp, STATE)

    def __exit__(self, *a):
        self.fcntl.flock(self.lock, self.fcntl.LOCK_UN)
        self.lock.close()


def log(line):
    try:
        with open(LOG, "a") as f:
            f.write("[%s] %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"), line))
    except OSError:
        pass


def when(t):
    return time.strftime("%H:%M:%S", time.localtime(t))


def dead_mcp(lease):
    """An `mcp-<pid>` lease from this host whose server process is gone (killed with -9)."""
    m = re.match(r"mcp-(\d+)$", lease.get("owner", ""))
    return bool(m) and lease.get("host") == os.uname().nodename and not pid_alive(m.group(1))


def live(rec, vm, now):
    """The lease if it is still unexpired, else None (and logs the expiry once)."""
    lease = rec.get("lease")
    if lease and lease["expires"] > now and dead_mcp(lease):
        log("vm=%s lease of %s: its MCP server is gone; free" % (vm, lease["owner"]))
        lease["expires"] = now
    if lease and lease["expires"] <= now:
        log("vm=%s lease of %s (%s) expired at %s; free" % (vm, lease["owner"],
                                                           lease.get("purpose") or "-", when(lease["expires"])))
        rec["history"].append({"owner": lease["owner"], "leased": lease["start"], "released": lease["expires"],
                               "expired": True})
        rec["lease"] = None
    return rec.get("lease")


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True


def suspending(rec, now):
    """True while a release/reap is suspending or pausing this VM right now."""
    s = rec.get("suspending")
    if s and (now - s.get("since", 0) > SUSPENDING_STALE or not pid_alive(s.get("pid"))):
        rec.pop("suspending", None)     # left behind by a run that was killed
        return False
    return bool(s)


def holder_or_exit(st, vm, owner, now):
    rec = st.vm(vm)
    lease = live(rec, vm, now)
    if not lease:
        st.save()
        raise Exit(3, "%s does not hold the desktop %s (it is free): run bb-desktop lease %s first" % (owner, vm, owner))
    if lease["owner"] != owner:
        raise Exit(3, "the desktop %s is leased by %s (%s), not %s" % (vm, lease["owner"], lease.get("purpose") or "-", owner),
                   held_by=lease["owner"], purpose=lease.get("purpose"))
    if suspending(rec, now):
        raise Exit(2, "the desktop %s is being suspended right now; lease it again once that finishes" % vm)
    return rec, lease


def supports_suspend():
    """True when the installed terminal-mac has `suspend` (save state to disk and exit, so
    the VM's RAM is freed; our fork adds it). Read from its --help once per binary and cached."""
    forced = os.environ.get("BB_DESKTOP_SUSPEND")
    if forced in ("0", "1"):
        return forced == "1"
    try:
        real = os.path.realpath(TMAC)
        info = os.stat(real)
        key = "%s:%d:%d" % (real, info.st_mtime, info.st_size)
    except OSError:
        return False
    cache = STATE + ".caps"
    try:
        with open(cache) as f:
            c = json.load(f)
        if c.get("key") == key:
            return bool(c["suspend"])
    except (OSError, ValueError, KeyError):
        pass
    try:
        p = subprocess.run([TMAC, "--help"], capture_output=True, text=True, timeout=20)
        text = p.stdout + p.stderr
    except (OSError, subprocess.TimeoutExpired):
        return False
    ok = any(re.match(r"\s*(\S+\|)*suspend(\||\s|$)", line) for line in text.splitlines())
    try:
        with open(cache, "w") as f:
            json.dump({"key": key, "suspend": ok}, f)
    except OSError:
        pass
    return ok


def mark(vm, **fields):
    """Set (or, with None, drop) per-VM flags under the lock. Returns the record's old values."""
    with State() as st:
        rec = st.vm(vm)
        old = {k: rec.get(k) for k in fields}
        for k, v in fields.items():
            if v is None:
                rec.pop(k, None)
            else:
                rec[k] = v
        st.save()
    return old


def flag(vm, name):
    with State() as st:
        return st.vm(vm).get(name)


def left(deadline, cap):
    """A timeout of at most `cap` s that still ends before `deadline`."""
    rest = deadline - time.time()
    if rest < 5:
        raise Exit(2, "ran out of time waking the VM; try the lease again (it is reused, not counted)")
    return max(5, min(cap, rest))


def wait_state(vm, want, seconds):
    end = time.time() + seconds
    while True:
        st, _ = vm_status(vm)
        if st == want or time.time() > end:
            return st
        time.sleep(2)


# A restore that fails for this reason may fall back to a plain start; any other failure is the human's call.
NO_SAVED_STATE = re.compile(r"no (saved|suspended)[ -]?(machine )?state|nothing to restore|not suspended|"
                            r"no such (file|saved)", re.I)


def check_ready(vm, deadline=None):
    """Wake a paused, suspended or cleanly stopped VM; refuse unless the guest helper has both
    permissions. Every wait is cut to end before `deadline` (what is left of the lease's budget).

    A stopped VM is cold-booted: its guest logs in by itself (auto-login) and starts the helper
    at login, and terminal-mac's `stop` only reports stopped once the guest has really shut down.
    Unknown, transitional or broken states (error, starting, stopping, a restore refused for any
    reason but a missing state, such as a disk that changed since the save) stay the human's call."""
    deadline = deadline or time.time() + 420
    st, _ = vm_status(vm)
    woke = cold = False
    if st == "paused":
        tmac("resume", vm, timeout=left(deadline, 60))
        log("vm=%s was paused; resumed" % vm)
        st, woke = "running", True
    elif st == "suspended" or (st == "stopped" and flag(vm, "suspended")):
        try:
            tmac("restore", vm, timeout=left(deadline, 180))
            log("vm=%s was suspended; restored" % vm)
        except Exit as e:
            # A plain start only when there is no saved state to lose: every other restore
            # failure (a mismatched or damaged state is kept by terminal-mac) is the human's call.
            if not NO_SAVED_STATE.search(e.msg):
                raise Exit(2, "could not restore the VM %s (%s, %s); ask the human" % (vm, st, e.msg), vm_state=st)
            log("vm=%s had no saved state to restore; starting it" % vm)
            tmac("start", vm, timeout=left(deadline, 180))
            cold = True
        st = wait_state(vm, "running", left(deadline, 120))
        woke = True
    elif st == "stopped":
        tmac("start", vm, timeout=left(deadline, 180))
        st = wait_state(vm, "running", left(deadline, 120))
        log("vm=%s was stopped; started it (%s)" % (vm, st))
        woke = cold = True
    if st == "running":
        mark(vm, suspended=None, **({"ours": True} if woke else {}))
    if st != "running":
        raise Exit(2, "the VM %s is %s, not running or stopped; ask the human" % (vm, st), vm_state=st)
    # A just-woken guest may need a few seconds before its helper answers again; a cold boot
    # needs the guest to boot, log in and launch the helper.
    end = min(deadline, time.time() + (180 if cold else 60 if woke else 0))
    while True:
        try:
            a = tmac("action", vm, "status", timeout=left(deadline, 30))
            break
        except Exit as e:
            if time.time() < end:
                time.sleep(3)
                continue
            raise Exit(2, "the guest helper in %s is not answering (%s); it needs setup inside the VM" % (vm, e.msg))
    if str(a.get("accessibility")).lower() != "true" or str(a.get("screenRecording")).lower() != "true":
        raise Exit(2, "the guest helper in %s is missing permissions (accessibility=%s, screenRecording=%s);"
                   " the human must grant them inside the VM" % (vm, a.get("accessibility"), a.get("screenRecording")))
    return a


def shot_path(vm, label):
    os.makedirs(SHOTS, exist_ok=True)
    return os.path.join(SHOTS, "%s-%s-%s.png" % (vm, label, time.strftime("%Y%m%d-%H%M%S")))


# ---- commands -------------------------------------------------------------------
def opt(args, name, default=None, flag=False):
    if name in args:
        i = args.index(name)
        if flag:
            args.pop(i)
            return True
        if i + 1 >= len(args):
            raise Exit(1, "%s needs a value" % name)
        args.pop(i)
        return args.pop(i)
    return False if flag else default


def cmd_lease(owner, args):
    vm = opt(args, "--vm", "default")
    purpose = opt(args, "--purpose")
    ttl = int(opt(args, "--ttl", TTL))
    started = time.time()
    deadline = started + LEASE_BUDGET - 30
    wait_until = started + 300          # a suspend in progress: wait for it, then wake the VM
    while True:
        now = time.time()
        with State() as st:
            rec = st.vm(vm)
            lease = live(rec, vm, now)
            if lease and lease["owner"] != owner:
                st.save()
                raise Exit(4, "the desktop %s is leased by %s for \"%s\" until %s; wait or ask"
                           % (vm, lease["owner"], lease.get("purpose") or "-", when(lease["expires"])),
                           held_by=lease["owner"], purpose=lease.get("purpose"), expires=lease["expires"])
            if lease:   # already ours: renew, not a new lease
                lease.update(expires=now + ttl, ttl=ttl, purpose=purpose or lease.get("purpose"))
                st.save()
                return {"leased": True, "already_yours": True, "vm": vm, "owner": owner, "expires": lease["expires"]}
            rec["history"] = [h for h in rec["history"] if h["released"] > now - STUCK_WINDOW]
            recent = [h for h in rec["history"] if h["owner"] == owner]
            if len(recent) >= STUCK_AFTER:
                st.save()
                log("vm=%s owner=%s refused: stuck (%d leases in 10 min)" % (vm, owner, len(recent)))
                raise Exit(5, "stuck: %s leased and released the desktop %s %d times in the last 10 minutes."
                           " Stop and ask the human in one line what is wrong." % (owner, vm, len(recent)))
            if not suspending(rec, now):
                # Hold it before checking the VM, so the reaper cannot pause it in between.
                rec["last_used"] = now
                rec["lease"] = {"owner": owner, "purpose": purpose, "start": now, "expires": now + ttl, "ttl": ttl,
                                "host": os.uname().nodename}
                st.save()
                break
            st.save()
        if time.time() > wait_until:
            raise Exit(2, "the desktop %s has been suspending for 5 minutes; ask the human" % vm)
        time.sleep(2)
    try:
        status = check_ready(vm, deadline)  # outside the lock; what a suspend wait used is gone
    except Exit:
        with State() as st:
            rec = st.vm(vm)
            if (rec.get("lease") or {}).get("owner") == owner and rec["lease"]["start"] == now:
                rec["lease"] = None
                st.save()
        raise
    log("vm=%s owner=%s leased ttl=%s purpose=%s" % (vm, owner, ttl, purpose or "-"))
    return {"leased": True, "vm": vm, "owner": owner, "purpose": purpose, "expires": now + ttl,
            "screen": [int(status.get("width", 1280)), int(status.get("height", 800))]}


def cmd_renew(owner, args):
    vm = opt(args, "--vm", "default")
    with State() as st:
        rec, lease = holder_or_exit(st, vm, owner, time.time())
        lease["expires"] = rec["last_used"] = time.time()
        lease["expires"] += lease.get("ttl", TTL)
        st.save()
    return {"renewed": True, "vm": vm, "owner": owner, "expires": lease["expires"]}


def cmd_release(owner, args):
    vm = opt(args, "--vm", "default")
    now = time.time()
    with State() as st:
        rec, lease = holder_or_exit(st, vm, owner, now)
        rec["history"].append({"owner": owner, "leased": lease["start"], "released": now})
        rec["lease"] = None
        rec["last_used"] = now
        st.save()
    log("vm=%s owner=%s released after %ds" % (vm, owner, now - lease["start"]))
    return {"released": True, "vm": vm, "owner": owner, "paused": pause_if_free(vm, "released by " + owner)}


# ---- freeing memory: pause what nobody is using -----------------------------------
def viewers(vm):
    """True when a `terminal-mac view` viewer is attached to `vm` (the human may be watching)."""
    src = os.environ.get("BB_DESKTOP_PS_FILE")
    if src:
        text = open(src).read()
    else:
        text = subprocess.run(["/bin/ps", "-axo", "command"], capture_output=True, text=True).stdout
    for line in text.splitlines():
        parts = line.split()
        if not parts or not os.path.basename(parts[0]).startswith("terminal-mac") or "view" not in parts[1:3]:
            continue
        rest, args = [], parts[parts.index("view") + 1:]
        while args:
            a = args.pop(0)
            if a == "--protocol" and args:
                args.pop(0)
            elif not a.startswith("-"):
                rest.append(a)
        if (rest[0] if rest else "default") == vm:
            return True
    return False


def vm_dir(vm):
    home = os.environ.get("TERMINAL_MAC_HOME") or os.path.expanduser("~/Library/Application Support/terminal-mac")
    return os.path.join(home, "machines", vm)


def guest_pids(vm):
    """The Virtualization XPC process that runs this VM's guest. Its parent is launchd, not the
    `__run` process, so it is found as the process holding the VM's disk image open."""
    try:
        out = subprocess.run(["/usr/sbin/lsof", "-t", "--", os.path.join(vm_dir(vm), "disk.img")],
                             capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return set()
    pids = {l.strip() for l in out.splitlines() if l.strip().isdigit()}
    if not pids:
        return set()
    ps = subprocess.run(["/bin/ps", "-axo", "pid=,command="], capture_output=True, text=True).stdout
    return {b[0] for b in (l.split(None, 1) for l in ps.splitlines())
            if len(b) == 2 and b[0] in pids and "Virtualization" in b[1]}


def vm_cpu(vm):
    """CPU % of this VM's guest process, averaged over two samples 3 s apart."""
    forced = os.environ.get("BB_DESKTOP_CPU")
    if forced is not None:
        return float(forced)
    pids = guest_pids(vm)
    if not pids:
        return 0.0
    total = 0.0
    for i in range(2):
        if i:
            time.sleep(3)
        out = subprocess.run(["/bin/ps", "-o", "%cpu=", "-p", ",".join(sorted(pids))],
                             capture_output=True, text=True).stdout
        for line in out.split():
            try:
                total += float(line)
            except ValueError:
                pass
    return total / 2


def mailbox_age(vm):
    """Seconds since anything went through the guest control mailbox (exchange/, the share the
    guest helper reads). Raw `terminal-mac action` and `terminal-mac mcp` calls show up here
    even though they never took a lease. None when there is no mailbox."""
    d = os.path.join(vm_dir(vm), "exchange")
    try:
        newest = os.stat(d).st_mtime
        for name in os.listdir(d):
            try:
                newest = max(newest, os.stat(os.path.join(d, name)).st_mtime)
            except OSError:
                pass
    except OSError:
        return None
    return time.time() - newest


def pause_if_free(vm, why):
    """Suspend `vm` (state to disk, RAM freed) when terminal-mac can, else pause it, unless a
    lease is live on it or a viewer is attached. Returns True when it did, else the reason.
    The lock is held only to check and mark: the slow suspend runs outside it."""
    how = "suspend" if supports_suspend() else "pause"
    with State() as st:
        rec = st.vm(vm)
        lease = live(rec, vm, time.time())
        if lease:
            st.save()
            return "leased by %s" % lease["owner"]
        if suspending(rec, time.time()):
            st.save()
            return "already being suspended"
        if viewers(vm):
            st.save()
            log("vm=%s not paused (%s): a terminal-mac viewer is attached" % (vm, why))
            return "viewer attached"
        was = rec.get("suspended")
        rec["suspending"] = {"since": time.time(), "how": how, "pid": os.getpid()}
        if how == "suspend":
            rec["suspended"] = True     # before the call, so a killed release still leaves it right
        st.save()
    result, err, attempted = True, None, False
    try:
        state, _ = vm_status(vm)
        if state != "running":
            result = "already %s" % state
        else:
            attempted = True
            tmac(how, vm, timeout=180 if how == "suspend" else 60)
    except Exit as e:
        err = e.msg
        result = "pause failed: %s" % e.msg[:120]
    after = None
    if attempted and err is not None:
        try:
            after, _ = vm_status(vm)
        except Exit:
            after = None            # unknown: keep the flag
    with State() as st:
        rec = st.vm(vm)
        rec.pop("suspending", None)
        if result is True:
            rec.pop("ours", None)
            rec["seen_running"] = False
        elif err is None or not attempted:  # nothing was suspended: put the flag back
            if was is None:
                rec.pop("suspended", None)
            else:
                rec["suspended"] = was
        elif after == "running":    # the suspend failed and the VM is still up: not suspended
            rec.pop("suspended", None)
        # else: the suspend failed but the VM is not running (it may have saved): keep the flag
        st.save()
    if err:
        log("vm=%s %s FAILED (%s): %s" % (vm, how, why, err[:120]))
    elif result is True:
        log("vm=%s %s (%s)" % (vm, "suspended" if how == "suspend" else "paused", why))
    return result


def cmd_reap(args):
    """Pause every running VM whose lease expired, or that has had no lease for IDLE_PAUSE s.
    A VM the broker did not wake starts its idle clock the first time reap sees it running,
    and a VM whose CPU is busy is left alone (someone is working in it)."""
    try:
        names = [m["name"] for m in tmac("ls", timeout=30) if isinstance(m, dict) and m.get("name")]
    except (Exit, TypeError):
        names = []
    out = {}
    for vm in names or ["default"]:
        try:
            state, pid = vm_status(vm)
        except Exit as e:
            out[vm] = "status failed: %s" % e.msg[:80]
            continue
        now = time.time()
        first_sight = False
        with State() as st:
            rec = st.vm(vm)
            had = rec.get("lease")
            lease = live(rec, vm, now)
            just_expired = had is not None and lease is None
            if state != "running":
                rec["seen_running"] = False
            else:
                rec.pop("suspended", None)
                if not lease and not rec.get("seen_running"):
                    rec["seen_running"] = True
                    if not rec.get("ours") or "last_used" not in rec:
                        rec["last_used"] = now      # not woken by us: the 10 minutes start now
                        first_sight = not just_expired
            idle = now - rec.get("last_used", now)
            st.save()
        if lease:
            out[vm] = "leased by %s" % lease["owner"]
        elif state != "running":
            out[vm] = "already %s" % state
        elif first_sight:
            out[vm] = "first seen running; idle clock started"
        elif just_expired or idle >= IDLE_PAUSE:
            age = mailbox_age(vm)
            cpu = None if age is not None and age < IDLE_PAUSE else vm_cpu(vm)
            if cpu is None:
                log("vm=%s not paused: its control mailbox was used %ds ago (outside a lease?)" % (vm, age))
                out[vm] = "mailbox active %ds ago" % age
            elif cpu > CPU_BUSY:
                log("vm=%s not paused: busy (cpu %.0f%%), someone is working in it" % (vm, cpu))
                out[vm] = "busy (cpu %.0f%%)" % cpu
            else:
                out[vm] = pause_if_free(vm, "lease expired" if just_expired else "idle %d min" % (idle // 60))
        else:
            out[vm] = "idle %ds of %ds" % (idle, IDLE_PAUSE)
    return {"reap": out}


def cmd_act(owner, args):
    vm = opt(args, "--vm", "default")
    native = opt(args, "--native", flag=True) or NATIVE_TYPE
    if not args:
        raise Exit(1, "act needs a verb: click|key|type|scroll|drag|screenshot")
    verb, rest = args[0], args[1:]
    if verb not in ("click", "key", "type", "scroll", "drag", "screenshot", "move"):
        raise Exit(1, "unknown act verb %s" % verb)
    with State() as st:
        rec, lease = holder_or_exit(st, vm, owner, time.time())
        lease["expires"] = rec["last_used"] = time.time()
        lease["expires"] += lease.get("ttl", TTL)
        st.save()
    out = {"vm": vm, "owner": owner, "act": verb}
    try:
        if verb == "type":
            words = rest[1:] if rest[:1] == ["--text"] else rest
            text = " ".join(words)      # unquoted words are typed with spaces, never dropped
            what = "type len=%d%s" % (len(text), " native" if native else "")
            if native:
                tmac("action", vm, "type", "--", text)
            else:
                chords = keys_for(text)
                for k in chords:
                    tmac("action", vm, "key", k, timeout=20)
            out["typed_chars"] = len(text)
        elif verb == "screenshot":
            path = rest[0] if rest else shot_path(vm, owner)
            os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
            tmac("action", vm, "screenshot", "--output", path)
            out["screenshot"] = path
            what = "screenshot"
        else:
            out["reply"] = tmac("action", vm, verb, *rest)
            what = " ".join([verb] + rest)[:80]
        log("vm=%s owner=%s %s ok" % (vm, owner, what))
    except Exit as e:
        log("vm=%s owner=%s %s FAILED: %s" % (vm, owner, verb, e.msg[:120]))
        raise
    return out


def cmd_peek(args):
    vm = opt(args, "--vm", "default")
    now = time.time()
    with State() as st:
        rec = st.vm(vm)
        lease = live(rec, vm, now)
        st.save()
    out = {"vm": vm, "held_by": lease and lease["owner"], "purpose": lease and lease.get("purpose"),
           "expires": lease and lease["expires"],
           "seconds_left": lease and int(lease["expires"] - now)}
    if not lease:
        last = rec["history"][-1] if rec["history"] else None
        out["free"] = True
        if last:
            out["last"] = "%s, %s at %s" % (last["owner"], "expired" if last.get("expired") else "released",
                                             when(last["released"]))
    if rec.get("suspending"):
        out["suspending"] = True
    out["vm_state"], _ = vm_status(vm)
    if out["vm_state"] == "running":
        try:
            path = shot_path(vm, "peek")
            tmac("action", vm, "screenshot", "--output", path)
            out["screenshot"] = path
        except Exit as e:
            out["screenshot_error"] = e.msg
    return out



# ---- bb-desktop mcp: terminal-mac's MCP tools, behind a lease ------------------------
# The raw `terminal-mac mcp` lets an agent drive the guest with no lease, invisible to the
# reaper and to other agents. This serves the same tool names and arguments (so the
# terminal-mac skill still applies), but takes a lease as mcp-<pid> on the first call,
# renews it on every call, types key by key, and releases it on exit or after 10 idle minutes.
_P = {"type": "integer", "minimum": 0}
_AFTER = {"type": "boolean", "description": "Also return a screenshot taken shortly after the action."}


def _schema(props, required=()):
    return {"type": "object", "properties": props, "required": list(required), "additionalProperties": False}


MCP_TOOLS = [
    {"name": "screenshot", "description": "Capture the virtual Mac's screen. Coordinates for other tools are pixels in this image.",
     "inputSchema": _schema({}), "annotations": {"readOnlyHint": True}},
    {"name": "click", "description": "Click at a point. clicks: 2 double-clicks, 3 triple-clicks.",
     "inputSchema": _schema({"x": _P, "y": _P, "button": {"type": "string", "enum": ["left", "right"]},
                             "clicks": {"type": "integer", "minimum": 1, "maximum": 3}, "screenshot": _AFTER}, ["x", "y"])},
    {"name": "move", "description": "Move the pointer, for example to reveal a hover menu or tooltip.",
     "inputSchema": _schema({"x": _P, "y": _P, "screenshot": _AFTER}, ["x", "y"])},
    {"name": "drag", "description": "Press the left button at (x, y), drag to (toX, toY) and release. Selects text, moves windows and items.",
     "inputSchema": _schema({"x": _P, "y": _P, "toX": _P, "toY": _P, "screenshot": _AFTER}, ["x", "y", "toX", "toY"])},
    {"name": "scroll", "description": "Scroll at a point. Negative dy scrolls content down (like swiping up), positive dy scrolls up. Pixels, -1000…1000.",
     "inputSchema": _schema({"x": _P, "y": _P, "dy": {"type": "integer"}, "dx": {"type": "integer"}, "screenshot": _AFTER},
                            ["x", "y", "dy"])},
    {"name": "type", "description": "Type literal text into the focused field. Use `key` for return, tab and shortcuts.",
     "inputSchema": _schema({"text": {"type": "string"}, "screenshot": _AFTER}, ["text"])},
    {"name": "key", "description": "Press a key or chord: return, tab, escape, backspace, up, cmd+space, cmd+tab, cmd+c, cmd+shift+... Modifiers: cmd, ctrl, alt, shift.",
     "inputSchema": _schema({"key": {"type": "string"}, "screenshot": _AFTER}, ["key"])},
    {"name": "status", "description": "Report whether the VM is running and the guest helper has its privacy permissions.",
     "inputSchema": _schema({}), "annotations": {"readOnlyHint": True}},
]
MCP_INSTRUCTIONS = ("Controls a separate virtual Mac, not the user's own desktop. Call `screenshot` first; every "
                    "x/y is a pixel in that screenshot (top-left origin), which equals guest screen points. "
                    "Take another screenshot after actions to check the result. If the guest is at its login "
                    "screen or a macOS permission prompt appears, ask the user to handle it. The first call "
                    "takes the desktop lease for this session; if another agent holds it the call says who.")


class McpSession:
    def __init__(self, vm="default"):
        import threading
        self.vm, self.owner = vm, "mcp-%d" % os.getpid()
        self.leased, self.screen, self.last = False, (1280, 800), time.time()
        self.lock = threading.Lock()

    def ensure_lease(self):
        if not self.leased:
            r = cmd_lease(self.owner, ["--vm", self.vm, "--purpose", "terminal-mac MCP session",
                                       "--ttl", str(int(MCP_IDLE + 60))])
            self.screen = tuple(r.get("screen") or self.screen)
            self.leased = True

    def release(self, why):
        if self.leased:
            self.leased = False
            try:
                cmd_release(self.owner, ["--vm", self.vm])
                log("vm=%s owner=%s MCP lease released (%s)" % (self.vm, self.owner, why))
            except Exit as e:
                log("vm=%s owner=%s MCP release: %s" % (self.vm, self.owner, e.msg[:120]))

    def act(self, *args):
        try:
            return cmd_act(self.owner, ["--vm", self.vm] + [str(a) for a in args])
        except Exit as e:
            if e.code == 3:             # our lease expired or was taken: get a fresh one once
                self.leased = False
                self.ensure_lease()
                return cmd_act(self.owner, ["--vm", self.vm] + [str(a) for a in args])
            raise

    def shot(self):
        path = shot_path(self.vm, self.owner)
        self.act("screenshot", path)
        w, h = self.screen
        jpg = path[:-4] + ".jpg"
        try:    # point-sized JPEG like terminal-mac's own MCP; sips is macOS only
            ok = subprocess.run(["/usr/bin/sips", "-s", "format", "jpeg", "-s", "formatOptions", "85",
                                 "-z", str(h), str(w), path, "--out", jpg], capture_output=True,
                                text=True, timeout=30).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        if ok and os.path.exists(jpg):
            data, mime = open(jpg, "rb").read(), "image/jpeg"
            os.remove(jpg)
        else:
            data, mime = open(path, "rb").read(), "image/png"
        os.remove(path)
        return [{"type": "image", "data": base64.b64encode(data).decode(), "mimeType": mime},
                {"type": "text", "text": "Screen: %d×%d. Use these pixel coordinates." % (w, h)}]

    def call(self, tool, a):
        def need(k, kind=int):
            if k not in a:
                raise Exit(1, "Missing '%s'" % k)
            if kind is str:
                return str(a[k])
            if isinstance(a[k], bool) or not isinstance(a[k], (int, float)):
                raise Exit(1, "'%s' must be an integer" % k)
            return int(a[k])
        if not isinstance(a, dict):
            raise Exit(1, "arguments must be an object")
        self.last = time.time()
        try:
            return self._call(tool, a, need)
        finally:
            self.last = time.time()     # the idle clock starts when the call ends, not when it began

    def _call(self, tool, a, need):
        if tool == "status":
            st, _ = vm_status(self.vm)
            text = "VM '%s' is %s." % (self.vm, st)
            if st == "running":
                text += "\n" + "\n".join("%s: %s" % kv for kv in sorted(tmac("action", self.vm, "status").items()))
            with State() as stt:
                lease = live(stt.vm(self.vm), self.vm, time.time())
            text += "\nlease: %s" % (("held by %s (%s)" % (lease["owner"], lease.get("purpose") or "-")) if lease else "free")
            return [{"type": "text", "text": text}]
        if tool not in ("screenshot", "click", "move", "drag", "scroll", "type", "key"):
            raise Exit(1, "Unknown tool: %s" % tool)
        # Check every argument before taking the lease, so a bad call never wakes the VM.
        steps = []
        if tool == "click":
            extra = ["--button", "right"] if a.get("button") == "right" else []
            clicks = max(1, min(3, need("clicks") if "clicks" in a else 1))
            x, y = need("x"), need("y")
            if clicks == 1:
                steps.append(("click", x, y, *extra))
            else:
                steps.append(("click", x, y, *(extra + ["--double"])))     # clicks 1 and 2 of the sequence
                if clicks == 3:
                    # the third click continues it; the guest helper reads count=3 as a triple click
                    steps.append(("click", x, y, *(extra + ["--count", 3])))
        elif tool == "move":
            steps.append(("move", need("x"), need("y")))
        elif tool == "drag":
            steps.append(("drag", need("x"), need("y"), need("toX"), need("toY")))
        elif tool == "scroll":
            steps.append(("scroll", "--dy", need("dy"), "--x", need("x"), "--y", need("y"),
                          *(["--dx", need("dx")] if a.get("dx") is not None else [])))
        elif tool == "type":
            text = need("text", str)
            keys_for(text)              # refuses unmappable characters up front
            steps.append(("type", "--text", text))
        elif tool == "key":
            steps.append(("key", need("key", str)))
        self.ensure_lease()
        if tool == "screenshot":
            return self.shot()
        for step in steps:
            self.act(*step)
        content = [{"type": "text", "text": "Done: %s." % tool}]
        if a.get("screenshot") is True:
            time.sleep(0.4)
            content += self.shot()
        return content


def cmd_mcp(args):
    import threading
    vm = opt(args, "--vm", "default")
    sess = McpSession(vm)
    out = sys.stdout

    def send(msg):
        out.write(json.dumps(msg) + "\n")
        out.flush()

    def idle_watch():
        while True:
            time.sleep(min(30, max(0.2, MCP_IDLE / 4)))
            with sess.lock:
                if sess.leased and time.time() - sess.last > MCP_IDLE:
                    sess.release("idle %ds" % MCP_IDLE)

    threading.Thread(target=idle_watch, daemon=True).start()
    import signal

    def stop(signum, frame):
        raise SystemExit(0)     # unwinds to the finally below, which releases the lease
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, stop)
    try:
        for line in sys.stdin:
            try:
                handle(line, sess, send)
            except Exception as e:      # never let one bad message end the server
                log("vm=%s MCP message failed: %s" % (vm, str(e)[:120]))
    finally:
        with sess.lock:
            sess.release("session ended")
    return None


def handle(line, sess, send):
    try:
        msg = json.loads(line)
    except ValueError:
        send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
        return
    if not isinstance(msg, dict):
        send({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "Invalid request"}})
        return
    if "id" not in msg:
        return          # notifications get no reply
    mid, method = msg["id"], msg.get("method")
    params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
    try:
        if method == "initialize":
            send({"jsonrpc": "2.0", "id": mid, "result": {
                "protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                "serverInfo": {"name": "terminal-mac", "version": "bb-desktop"}, "instructions": MCP_INSTRUCTIONS}})
        elif method == "ping":
            send({"jsonrpc": "2.0", "id": mid, "result": {}})
        elif method == "tools/list":
            send({"jsonrpc": "2.0", "id": mid, "result": {"tools": MCP_TOOLS}})
        elif method == "tools/call":
            with sess.lock:
                try:
                    args = params.get("arguments")
                    content = sess.call(str(params.get("name", "")), {} if args is None else args)
                    send({"jsonrpc": "2.0", "id": mid, "result": {"content": content}})
                except Exception as e:
                    text = e.msg if isinstance(e, Exit) else "%s: %s" % (type(e).__name__, e)
                    send({"jsonrpc": "2.0", "id": mid, "result": {
                        "content": [{"type": "text", "text": text}], "isError": True}})
        else:
            send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "Method not found"}})
    except Exception as e:
        send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": "Internal error: %s" % str(e)[:200]}})

# ---- remote requests: run once, answer repeats from the done-set -------------------
def request_claim(rid, wait):
    """None when this request id is new (now marked running); else (rc, reply) of the first
    run, waiting up to `wait` s for it if it is still running."""
    end = time.time() + wait
    while True:
        with State() as st:
            reqs = st.data.setdefault("_requests", {})
            now = time.time()
            for k in [k for k, v in reqs.items() if now - v.get("t", 0) > REQUEST_KEEP]:
                del reqs[k]
            r = reqs.get(rid)
            if r is None:
                reqs[rid] = {"t": now, "state": "running", "pid": os.getpid()}
                st.save()
                return None
            st.save()
            if r["state"] == "done":
                return r["rc"], dict(r["reply"], repeat=True)
            if not pid_alive(r.get("pid")):
                return 1, {"error": "the first run of request %s died before it finished; check with"
                           " bb-desktop peek before trying again" % rid, "repeat": True}
        if time.time() > end:
            return 1, {"error": "request %s is still running on the VM host" % rid, "repeat": True}
        time.sleep(1)


def request_done(rid, rc, reply, tries=5):
    """Record the result for repeats. The action already happened, so failing to record it is
    a warning in the log, never a failure of the action."""
    for i in range(tries):
        try:
            with State() as st:
                st.data.setdefault("_requests", {})[rid] = {"t": time.time(), "state": "done", "rc": rc,
                                                            "reply": reply}
                st.save()
            return True
        except (Exit, OSError) as e:
            err = getattr(e, "msg", str(e))
            time.sleep(0.2 * (2 ** i))
    log("WARNING request %s finished (rc=%s) but could not be recorded: %s" % (rid, rc, err[:120]))
    return False


# ---- running it on the VM host ------------------------------------------------------
def remote(argv):
    """Run this same command on the VM host. Screenshots come back to the same path here."""
    argv = list(argv)
    want_local = None
    if argv[:1] == ["act"] and "screenshot" in argv:
        i = argv.index("screenshot")
        if i + 1 < len(argv):
            want_local = argv.pop(i + 1)
    rid = uuid.uuid4().hex
    script = ("echo __BBD_START; export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH;"
              " BB_DESKTOP_REQUEST_ID=%s %s %s; echo __BBD_RC=$?"
              % (rid, REMOTE_BIN, " ".join(shlex.quote(a) for a in argv)))
    out, how = run_on_mini(script, budget(argv) + 30)
    lines = out.rstrip("\n").split("\n")
    rc_line = next((l for l in reversed(lines) if l.startswith("__BBD_RC=")), None)
    if rc_line is None:
        raise Exit(1, "the VM host gave no answer (%s): %s" % (how, out.strip()[-300:]))
    rc = int(rc_line.split("=", 1)[1])
    body = [l for l in lines if l.strip() and not l.startswith("__BBD_")]
    reply = next((json.loads(l) for l in reversed(body) if l.startswith("{")), {})
    for l in body:
        if not l.startswith("{"):
            print(l, file=sys.stderr)
    reply["ran_on"] = "VM host via " + how
    if reply.get("screenshot"):
        local = want_local or reply["screenshot"]
        fetch(reply["screenshot"], local)
        reply["screenshot"] = local
    return rc, reply


def _text(x):
    return x.decode(errors="replace") if isinstance(x, bytes) else (x or "")


def run_on_mini(script, timeout, retry_after_start=False):
    """(stdout, how). LAN ssh first; the relay only when the LAN connection itself failed.
    Once the LAN run has printed __BBD_START it is never re-sent (unless the caller says
    the script is safe to repeat): a lost answer is an error, not a retry. The script is
    base64'd so no layer of quoting can mangle it."""
    b64 = base64.b64encode(script.encode()).decode()
    inner = "echo %s | base64 -d | /bin/zsh -l" % b64
    if MINI:
        try:
            p = subprocess.run(["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", MINI, inner],
                               capture_output=True, text=True, timeout=timeout)
            out, started, rc = p.stdout, "__BBD_START" in p.stdout, p.returncode
        except subprocess.TimeoutExpired as e:
            out, rc = _text(e.stdout), None
            started = "__BBD_START" in out
        if "__BBD_RC=" in out:
            return out, "lan"
        if started and not retry_after_start:
            raise Exit(1, "the command started on the VM host over the LAN but its answer was lost; it was"
                       " not re-sent. Check with bb-desktop peek before trying again.")
        if not started and rc not in (255, None):
            raise Exit(1, "the VM host's shell failed over the LAN (exit %s): %s" % (rc, (out or p.stderr).strip()[-300:]))
    if not (RELAY and RELAY_RUN):
        raise Exit(1, "the VM host is not reachable over the LAN and no relay is configured"
                   " (BB_DESKTOP_MINI / BB_DESKTOP_RELAY / BB_DESKTOP_RELAY_RUN in %s)" % CONFIG)
    try:
        p = subprocess.run(["ssh", "-o", "ConnectTimeout=10", RELAY, "%s '%s' %d" % (RELAY_RUN, inner, timeout)],
                           capture_output=True, text=True, timeout=timeout + 30)
    except subprocess.TimeoutExpired:
        raise Exit(1, "the VM host did not answer over the relay within %ss" % timeout)
    return p.stdout, "relay"


def fetch(remote_path, local_path):
    """Copy a screenshot back from the VM host. Fails loudly on a bad copy."""
    out, _ = run_on_mini("echo __BBD_START; base64 -i %s; rc=$?; echo; echo __BBD_RC=$rc" % shlex.quote(remote_path),
                         120, retry_after_start=True)
    lines = out.split("\n")
    rc_line = next((l for l in reversed(lines) if l.startswith("__BBD_RC=")), None)
    if rc_line != "__BBD_RC=0":
        raise Exit(1, "could not copy the screenshot %s back from the VM host (%s)" % (remote_path, rc_line or "no answer"))
    data = "".join(l.strip() for l in lines if l.strip() and not l.startswith("__BBD_"))
    try:
        png = base64.b64decode(data, validate=True)
    except ValueError as e:
        raise Exit(1, "the screenshot %s came back corrupted (%s)" % (remote_path, e))
    if not png.startswith(b"\x89PNG"):
        raise Exit(1, "the screenshot %s came back but is not a PNG" % remote_path)
    os.makedirs(os.path.dirname(os.path.abspath(local_path)), exist_ok=True)
    with open(local_path, "wb") as f:
        f.write(png)


# ---- main -------------------------------------------------------------------------
def run_local(argv):
    cmd, args = argv[0], list(argv[1:])
    if cmd == "peek":
        return cmd_peek(args)
    if cmd == "reap":
        return cmd_reap(args)
    if cmd in ("lease", "act", "renew", "release"):
        if not args or args[0].startswith("-"):
            raise Exit(1, "usage: bb-desktop %s <owner> ..." % cmd)
        owner = args.pop(0)
        return {"lease": cmd_lease, "act": cmd_act, "renew": cmd_renew, "release": cmd_release}[cmd](owner, args)
    raise Exit(1, "unknown command %s (lease|act|renew|peek|release|reap)" % cmd)


def main(argv):
    global TMAC
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__, file=sys.stderr)
        return 1
    TMAC = local_tmac()
    if argv[0] == "mcp":
        if TMAC is None:
            print("bb-desktop mcp runs on the machine with terminal-mac (the VM host)", file=sys.stderr)
            return 1
        cmd_mcp(list(argv[1:]))
        return 0
    rid = os.environ.get("BB_DESKTOP_REQUEST_ID") if TMAC else None
    try:
        if TMAC is None:
            rc, reply = remote(argv)
        else:
            prior = request_claim(rid, budget(argv)) if rid else None
            if prior:
                rc, reply = prior
                print(json.dumps(reply))
                return rc
            try:
                rc, reply = 0, run_local(argv)
            except Exit as e:
                print(e.msg, file=sys.stderr)
                rc, reply = e.code, dict(error=e.msg, **e.extra)
            if rid:
                request_done(rid, rc, reply)
    except Exit as e:
        print(e.msg, file=sys.stderr)
        rc, reply = e.code, dict(error=e.msg, **e.extra)
    print(json.dumps(reply))
    return rc


TMAC = None
if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
