VAULT_PY = r'''
import json,sys
t=sys.argv[1].lower()
rows=[r for r in json.load(open(sys.argv[2])) if t in r["site"].lower() or t in r["url"].lower()]
print(json.dumps(rows))
'''


def vault_rows(term):
    r = subprocess.run(["ssh", CONF("BA_VAULT_SSH", "vault"), "python3 - " + json.dumps(term) + " " + json.dumps(CONF("BA_VAULT_FILE", "passwords.json"))], input=VAULT_PY,
                       capture_output=True, text=True, timeout=30)
    try:
        return json.loads(r.stdout.strip() or "[]")
    except ValueError:
        return []


def pick(rows, user=None):
    if user:
        rows = [r for r in rows if user.lower() in r["user"].lower()] or rows
    rows = [r for r in rows if r.get("password")]
    if not rows:
        return None
    good = [r for r in rows if LOGINISH.search(urlparse(r["url"]).path or "")]
    return (good or rows)[0]


def login_url(row, override=None):
    if override:
        return override
    host = urlparse(row["url"]).hostname or urlparse(row["site"]).hostname or ""
    if host in LOGIN_URLS:
        return LOGIN_URLS[host]
    if LOGINISH.search(urlparse(row["url"]).path or "") or LOGINISH.search(host):
        return row["url"]
    return row["site"]


# ---------- broker lease (REST, so --keep can leave the tab alive on a TTL) ----------
def post(path, body):
    req = Request(BROKER + path, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"},
                  method="POST")
    with urlopen(req, timeout=60) as r:
        return json.load(r)


class Lease:
    def __init__(self, owner, url):
        self.owner = owner
        self.g = post("/lease", {"owner": owner, "url": url, "purpose": "bb-login", "hidden": True, "ttl": 300})
        self.stop = threading.Event()
        self.ttl = 300
        threading.Thread(target=self._renew, daemon=True).start()
        self.tab = Tab(self.g["ws_url"], step_timeout=15)

    def _renew(self):
        while not self.stop.wait(60):
            try:
                post("/renew", {"lease_id": self.g["lease_id"], "ttl": self.ttl})
            except Exception:
                pass

    def done(self, keep=False):
        self.stop.set()
        if keep:
            try:
                post("/renew", {"lease_id": self.g["lease_id"], "ttl": KEEP_TTL})
            except Exception:
                pass
            self.tab.close()
            return
        self.tab.close()
        try:
            post("/release", {"lease_id": self.g["lease_id"]})
        except Exception:
            pass


