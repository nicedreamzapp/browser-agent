def ev(tab, js, timeout=15):
    try:
        return tab.eval(js, timeout=timeout)
    except Exception:
        return None


def call(tab, fn, *args):
    doc = tab.send("Runtime.evaluate", expression="document")["result"]["objectId"]
    r = tab.send("Runtime.callFunctionOn", objectId=doc, functionDeclaration=fn,
                 arguments=[{"value": a} for a in args], returnByValue=True)
    return r.get("result", {}).get("value")


def state(tab):
    return ev(tab, STATE_JS) or {}


def wait_ready(tab, secs=20):
    end = time.time() + secs
    s = {}
    while time.time() < end:
        s = state(tab)
        if s.get("ready") == "complete" and (s.get("pw") or s.get("user") or s.get("otp") or time.time() > end - secs + 4):
            return s
        time.sleep(1)
    return s


def submit(tab):
    before = (state(tab) or {}).get("url")
    b = ev(tab, SUBMIT_JS)
    if b:
        for t in ("mousePressed", "mouseReleased"):
            tab.send("Input.dispatchMouseEvent", type=t, x=b["x"], y=b["y"], button="left", clickCount=1)
    time.sleep(3)
    s = state(tab)
    if s.get("url") == before and (s.get("pw") or s.get("user") or s.get("otp")) and not s.get("wrong"):
        ev(tab, "(()=>{const f=window.__bbl_form;if(f){f.requestSubmit?f.requestSubmit():f.submit();return 1}"
                "const a=document.activeElement;if(a){a.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',keyCode:13,bubbles:true}));}return 0})()")
    return b


def outcome(tab, start_url, secs=20):
    """Poll until the page says what happened after a submit."""
    end = time.time() + secs
    s = {}
    while time.time() < end:
        time.sleep(1.5)
        s = state(tab)
        if not s:
            continue
        if s.get("captcha"):
            return "captcha", s
        if (s.get("twofa") and (s.get("otp") or s.get("boxes") >= 4)) or s.get("otc"):
            return "twofa", s
        if s.get("wrong") and s.get("pw"):
            return "wrong_password", s
        if not s.get("pw") and not s.get("user") and s.get("ready") == "complete" and \
                (s.get("url") != start_url or s.get("signed")) and not LOGINISH.search(urlparse(s.get("url", "")).path):
            return "logged_in", s
    if s.get("pw") and s.get("wrong"):
        return "wrong_password", s
    if s and not s.get("pw") and not s.get("user") and not s.get("otp") and \
            not LOGINISH.search(urlparse(s.get("url", "")).path):
        return "logged_in", s
    return "stuck", s


def shot(tab, name, crop=None):
    os.makedirs(SHOTS, exist_ok=True)
    p = os.path.join(SHOTS, "%s-%s.png" % (re.sub(r"[^\w.-]+", "_", name), time.strftime("%H%M%S")))
    try:
        import base64
        kw = {"format": "png", "captureBeyondViewport": True}
        if crop:
            kw["clip"] = {"x": crop["x"], "y": crop["y"], "width": crop["w"], "height": crop["h"], "scale": 1}
        data = tab.send("Page.captureScreenshot", _timeout=20, **kw)["data"]
        open(p, "wb").write(base64.b64decode(data))
        return p
    except Exception:
        return None


# ---------- fresh 2FA codes ----------
CODE_HINT = re.compile(r"code|verif|otp|passcode|\bpin\b|log ?in|sign ?in|security|one.?time|2fa|authenticat|confirm", re.I)


def extract(text, mine=False):
    t = text or ""
    if mine:   # owner texting a bare code back
        m = re.fullmatch(r"\s*(\d[\d\s-]{2,10}\d)\s*", t)
        if m:
            d = re.sub(r"\D", "", m.group(1))
            return d if 4 <= len(d) <= 8 else None
    if not CODE_HINT.search(t):
        return None
    num = r"(\d{3}[- ]\d{3}|\d{4,8})(?![\d,]|\.\d)"
    pats = [r"(?:code|passcode|otp|pin|verification|one.?time|security code|log ?in code)\D{0,40}?(?<![\d$#])" + num,
            r"(?<![\d$#.,/:])" + num + r"[^\n]{0,30}?(?:is your|is the|as your)?[^\n]{0,15}?(?:code|passcode|otp|pin)\b"]
    for pt in pats:
        m = re.search(pt, t, re.I)
        if m:
            d = re.sub(r"\D", "", m.group(1))
            if not re.fullmatch(r"(19|20)\d\d", d):
                return d
    return None


def _chatdb(sql):
    try:
        db = sqlite3.connect("file:%s?mode=ro" % CHATDB, uri=True, timeout=5)
        rows = db.execute(sql).fetchall()
        db.close()
        return rows
    except Exception:
        pass
    if not CONF("BA_CHATDB_SSH"):
        return []
    r = subprocess.run(CONF("BA_CHATDB_SSH").split() + ["/usr/bin/sqlite3 -readonly -json \"$HOME/Library/Messages/chat.db\""],
                       input=sql, capture_output=True, text=True, timeout=25)
    try:
        return [tuple(d.values()) for d in json.loads(r.stdout or "[]")]
    except ValueError:
        return []


def text_codes(since):
    apple = int((since - 978307200) * 1e9)
    sql = ("SELECT m.ROWID, c.chat_identifier, COALESCE(m.text,''), hex(m.attributedBody) FROM message m "
           "JOIN chat_message_join j ON j.message_id=m.ROWID JOIN chat c ON c.ROWID=j.chat_id "
           "WHERE m.is_from_me=0 AND m.date > %d AND c.chat_identifier != '%s' ORDER BY m.date DESC LIMIT 20"
           % (apple, ECHO))
    out = []
    for _rid, who, txt, body in _chatdb(sql):
        if not txt and body:      # newer messages keep the words only in attributedBody
            raw = bytes.fromhex(body).decode("utf-8", "ignore")
            m = re.search(r"NSString.{1,6}?\+.(.+?)(?:\x86|\x84|NSDictionary)", raw, re.S)
            txt = (m.group(1) if m else raw)[:600]
        c = extract(txt, mine=bool(OWNER_PHONE) and OWNER_PHONE in (who or ""))
        if c:
            out.append((c, txt))
    return out


_MAIL = {}
KU, KT = CONF("BA_MAIL_URL_KEY", "MAIL_API_URL"), CONF("BA_MAIL_TOKEN_KEY", "MAIL_API_TOKEN")


def _mail():
    if not _MAIL:
        for f in [p for p in CONF("BA_MAIL_ENV").split(":") if p]:
            try:
                for line in open(f):
                    m = re.match(r"\s*(?:export\s+)?(%s|%s)\s*=\s*['\"]?([^'\"\s]+)" % (KU, KT), line)
                    if m:
                        _MAIL.setdefault("MAIL_API_URL" if m.group(1) == KU else "MAIL_API_TOKEN", m.group(2))
            except OSError:
                pass
    return _MAIL


def _mail_get(path):
    h = _mail()
    if not h.get("MAIL_API_URL"):
        return {}
    req = Request(h["MAIL_API_URL"] + path, headers={"Authorization": "Bearer " + h.get("MAIL_API_TOKEN", "")})
    try:
        with urlopen(req, timeout=20) as r:
            return json.load(r)
    except Exception:
        return {}


def mail_codes(since, seen):
    out = []
    for acct in [a for a in CONF("BA_MAIL_ACCOUNTS").split(",") if a]:
        d = _mail_get("/api/gmail/search?q=%s&account=%s" % (quote("newer_than:1d"), acct))
        for m in d.get("messages", [])[:15]:
            try:
                ts = int(m.get("ts", 0)) / 1000
            except ValueError:
                continue
            if ts < since - 5 or "SENT" in str(m.get("labels")):
                continue
            blob = "%s %s" % (m.get("subject", ""), m.get("snippet", ""))
            c = extract(blob)
            if not c and CODE_HINT.search(blob) and m.get("id") not in seen:
                seen.add(m.get("id"))
                full = _mail_get("/api/gmail/message/%s?account=%s" % (m.get("id"), acct))
                body = " ".join(str(full.get(k, "")) for k in ("subject", "body", "text", "snippet"))
                c = extract(body)
            if c:
                out.append((c, blob))
    return out


def text_owner(line):
    if SEND and os.path.exists(SEND):
        subprocess.run(["bash", SEND, line], capture_output=True, text=True, timeout=60,
                       env=dict(os.environ, IMESSAGE_TAG="LOGIN"))


def find_code(since, site_word, used, seen):
    cands = text_codes(since) + mail_codes(since, seen)
    cands = [(c, t) for c, t in cands if c not in used]
    if not cands:
        return None
    for c, t in cands:          # prefer a message naming the site
        if site_word and site_word in t.lower():
            return c
    return cands[0][0]


def cap_hint(owner):
    if os.path.exists(os.path.join(HOME, "Scripts/bb-captcha")):
        return " Tab kept: bb-captcha %s shot / click / submit, then rerun bb-login." % owner
    return " Tab kept as owner %s." % owner


# ---------- main ----------
def main():
    ap = argparse.ArgumentParser(description="Hands-free login from the password vault in a hidden tab.")
    ap.add_argument("site")
    ap.add_argument("--user")
    ap.add_argument("--url")
    ap.add_argument("--keep", action="store_true", help="leave the tab open (closes itself in 15 min)")
    ap.add_argument("--notify", action="store_true", help="text the owner the one-line result")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--force", action="store_true", help="allow a bank/gov/one-session site")
    ap.add_argument("--wait", type=int, default=90, help="seconds to wait for a 2FA code before texting the owner")
    a = ap.parse_args()
    t0 = time.time()
    res = {"site": a.site, "status": "stuck"}

    def finish(status, line, code, **extra):
        res.update(status=status, line=line, **extra)
        log("%s -> %s (%ds)" % (a.site, status, time.time() - t0))
        print(json.dumps(res) if a.json else line)
        if a.notify:
            text_owner("LOGIN: " + line)
        sys.exit(code)

    row = pick(vault_rows(a.site), a.user)
    if not row:
        finish("no_vault_entry", "No saved login for %s in the vault." % a.site, 6)
    url = login_url(row, a.url)
    host = (urlparse(url).hostname or a.site).lower()
    if REFUSE.search(host) and not a.force:
        finish("refused", "%s is a one-session or money site; rerun with --force if the owner said so." % host, 7)
    site_word = host.replace("www.", "").split(".")[0]
    owner = "bb-login-" + site_word
    res.update(owner=owner, broker=BROKER, user=row["user"])
    try:
        L = Lease(owner, url)
    except Exception as e:
        finish("stuck", "%s: the hidden browser refused the tab (%s)." % (host, str(e)[:120]), 5)
    tab = L.tab
    keep = a.keep
    try:
        tab.send("Page.enable")
        s = wait_ready(tab)
        if not s.get("pw") and not s.get("user") and not s.get("otp") and not LOGINISH.search(urlparse(s.get("url", "")).path):
            finish("already_logged_in", "%s: already logged in." % host, 0)
        if s.get("captcha") and not s.get("pw"):
            keep = True
            crop = shot(tab, owner + "-captcha", s.get("crop"))
            finish("captcha", "%s: captcha before the form; crop %s.%s" % (host, crop, cap_hint(owner)), 3, crop=crop)
        start_url = s.get("url")
        if s.get("pw"):
            call(tab, FILL_FN, row["user"], row["password"], bool(s.get("user")), True)
            submit(tab)
        elif s.get("user"):           # two-step form: username, then password
            call(tab, FILL_FN, row["user"], row["password"], True, False)
            submit(tab)
            end = time.time() + 15
            while time.time() < end and not state(tab).get("pw"):
                time.sleep(1)
            if not state(tab).get("pw"):
                st, s = outcome(tab, start_url, 8)
                if st not in ("twofa", "logged_in", "captcha"):
                    finish("stuck", "%s: no password box after the username step; screenshot %s." % (host, shot(tab, owner)), 5)
            else:
                call(tab, FILL_FN, row["user"], row["password"], False, True)
                submit(tab)
        st, s = outcome(tab, start_url)
        if st == "captcha":
            keep = True
            crop = shot(tab, owner + "-captcha", s.get("crop"))
            finish("captcha", "%s: captcha; crop %s.%s" % (host, crop, cap_hint(owner)), 3, crop=crop)
        if st == "wrong_password":
            finish("wrong_password", "%s: the site says the saved password for %s is wrong." % (host, row["user"]), 4)
        if st == "twofa":
            used, seen, texted = set(), set(), False
            deadline, hard = time.time() + a.wait, time.time() + a.wait + 120
            while time.time() < hard:
                code = find_code(t0, site_word, used, seen)
                if code:
                    used.add(code)
                    kind = call(tab, OTP_FN, code)
                    if kind:
                        time.sleep(1)
                        submit(tab)
                        st, s = outcome(tab, s.get("url"), 20)
                        if st == "logged_in":
                            finish("logged_in", "%s: logged in (2FA code typed)." % host, 0)
                        if st == "captcha":
                            keep = True
                            crop = shot(tab, owner + "-captcha", s.get("crop"))
                            finish("captcha", "%s: captcha after the code; crop %s.%s" % (host, crop, cap_hint(owner)), 3, crop=crop)
                if time.time() > deadline and not texted:
                    texted = True
                    text_owner("LOGIN: %s wants a code and none came in 90s. Text me the code." % host)
                time.sleep(3)
            keep = keep or a.keep
            finish("needs_code", "%s: asked for a 2FA code and none arrived; screenshot %s." % (host, shot(tab, owner)), 2)
        if st == "logged_in":
            finish("logged_in", "%s: logged in." % host, 0)
        finish("stuck", "%s: no clear result after submit; screenshot %s." % (host, shot(tab, owner)), 5)
    finally:
        L.done(keep=keep)


if __name__ == "__main__":
    main()
